 * SPDX-License-Identifier: MIT
 */

#define CI_TYPEOF_CI_SOCKLEN_T @CI_TYPEOF_CI_SOCKLEN_T@
#define CI_TYPEOF_CI_SSIZE_T @CI_TYPEOF_CI_SSIZE_T@

/* Prefix names with CI_ to make sure they don't conflict with other config.h
 * files.  We need to include some dependent headers that may be system specific
 * for C-Ares */
#undef CI_HAVE_SYS_TYPES_H
#undef CI_HAVE_SYS_SOCKET_H
#undef CI_HAVE_SYS_SELECT_H
#undef CI_HAVE_WINDOWS_H
#undef CI_HAVE_WS2TCPIP_H
#undef CI_HAVE_WINSOCK2_H
#undef CI_HAVE_ARPA_NAMESER_H
#undef CI_HAVE_ARPA_NAMESER_COMPAT_H

#ifdef CI_HAVE_SYS_TYPES_H
#  include <sys/types.h>
#endif

#ifdef CI_HAVE_SYS_SOCKET_H
#  include <sys/socket.h>
#endif

#ifdef CI_HAVE_SYS_SELECT_H
#  include <sys/select.h>
#endif

#ifdef CI_HAVE_WINSOCK2_H
#  include <winsock2.h>
#endif

#ifdef CI_HAVE_WS2TCPIP_H
#  include <ws2tcpip.h>
#endif

#ifdef CI_HAVE_WINDOWS_H
#  include <windows.h>
#endif

#endif /* __CI_BUILD_H */
